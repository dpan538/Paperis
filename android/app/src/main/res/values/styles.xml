<resources>
    <style name="InkTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F4F4F1</item>
        <item name="android:colorAccent">#333333</item>
        <item name="android:windowSplashScreenBackground">#F4F4F1</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_slogan</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
    <style name="InkThemeEnglish" parent="InkTheme">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_slogan_en</item>
    </style>
</resources>
